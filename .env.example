# Database: local SQLite file for development, Turso URL (libsql://...) in production.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Any long random string (at least 32 characters). Required in production.
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# true = seed a demo company with sample data and show demo logins on the sign-in page.
DEMO_MODE=true
# Password for the three demo users (admin, sales, warehouse) when DEMO_MODE=true.
DEMO_PASSWORD=demo1234
